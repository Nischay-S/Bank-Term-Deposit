   "cell_type": "markdown",
   "id": "17885e4b",
   "metadata": {},
   "source": [
    "## 7. Probability calibration and decision threshold (validation data only)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "32713976",
   "metadata": {},
   "outputs": [],
   "source": [
    "base = fitted[selected]\n",
    "cal_models = {\"none\": base}\n",
    "for method in (\"sigmoid\", \"isotonic\"):\n",
    "    cal_models[method] = CalibratedClassifierCV(estimator=clone(candidates[selected]), method=method, cv=5).fit(X_train, y_train)\n",
    "cal_rows = []\n",
    "for k, m in cal_models.items():\n",
    "    mm = metrics_at(y_val, proba(m, X_val), 0.5)\n",
    "    cal_rows.append({\"method\": k, \"brier\": mm[\"brier\"], \"log_loss\": mm[\"log_loss\"], \"ece\": mm[\"ece\"], \"pr_auc\": mm[\"pr_auc\"]})\n",
    "cal_table = pd.DataFrame(cal_rows)\n",
    "best_cal = cal_table.loc[cal_table.brier.idxmin(), \"method\"]\n",
    "final = cal_models[best_cal]\n",
    "display(cal_table.round(4))\n",
    "pv = proba(final, X_val)\n",
    "THRESHOLD, fb = best_threshold_fbeta(y_val, pv)\n",
    "print(f\"Calibration chosen by validation Brier score: {best_cal}\")\n",
    "print(f\"Decision threshold (maximises F{THRESHOLD_BETA:g} on validation): {THRESHOLD:.3f}\")"
   ]
  },
